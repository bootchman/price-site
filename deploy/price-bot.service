[Unit]
Description=price.interalex.pro — бот входа @priceIAPRO_bot
After=network-online.target
Wants=network-online.target

[Service]
User=price
Group=price
WorkingDirectory=/srv/price/app
EnvironmentFile=/root/iapro/price-site.env
Environment=PRICE_DATA_DIR=/srv/price/data PRICE_STATIC_ROOT=/srv/price/static
ExecStart=/srv/price/venv/bin/python manage.py run_bot
Restart=always
RestartSec=5
MemoryMax=300M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/srv/price/data

[Install]
WantedBy=multi-user.target
